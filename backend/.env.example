# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=helpro
DATABASE_PASSWORD=helpro_secure_password
DATABASE_NAME=helpro_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key
JWT_REFRESH_EXPIRATION=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_FEE_PERCENT=15

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DESTINATION=./uploads

# Notification
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@helpro.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Trust Score Weights
TRUST_WEIGHT_IDENTITY=0.25
TRUST_WEIGHT_COMPLETED_JOBS=0.30
TRUST_WEIGHT_REVIEWS=0.25
TRUST_WEIGHT_ON_TIME=0.10
TRUST_WEIGHT_DISPUTES=0.10

# Matching Weights
MATCH_WEIGHT_TRUST=0.4
MATCH_WEIGHT_DISTANCE=0.3
MATCH_WEIGHT_AVAILABILITY=0.2
MATCH_WEIGHT_PRICE=0.1
