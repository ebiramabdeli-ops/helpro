# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=helpro
DB_PASSWORD=helpro123
DB_DATABASE=helpro_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Stripe (Test keys)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Platform Fee (percentage)
PLATFORM_FEE_PERCENTAGE=15

# Trust Score Weights (should sum to 1.0)
TRUST_IDENTITY_WEIGHT=0.25
TRUST_COMPLETED_JOBS_WEIGHT=0.30
TRUST_REVIEWS_WEIGHT=0.25
TRUST_ON_TIME_WEIGHT=0.10
TRUST_DISPUTES_WEIGHT=0.10

# Matching Algorithm Weights (should sum to 1.0)
MATCHING_TRUST_WEIGHT=0.4
MATCHING_DISTANCE_WEIGHT=0.3
MATCHING_AVAILABILITY_WEIGHT=0.2
MATCHING_PRICE_WEIGHT=0.1

# Matching Configuration
MAX_MATCHING_DISTANCE_KM=50
MAX_MATCHING_ATTEMPTS=3
AUTO_ASSIGN_TIMEOUT_MINUTES=30

# Application
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Email (SendGrid example)
SENDGRID_API_KEY=your_sendgrid_key_here
EMAIL_FROM=noreply@helpro.com

# SMS (Twilio example)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
