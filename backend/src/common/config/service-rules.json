  "pricingRules": {
    "urgentBooking": {
      "description": "Same-day booking",
      "multiplier": 1.2,
      "applies": "all"
    },
    "weekendPremium": {
      "description": "Saturday/Sunday booking",
      "multiplier": 1.15,
      "applies": "all"
    },
    "eveningPremium": {
      "description": "After 6pm",
      "multiplier": 1.1,
      "applies": "all"
    },
    "distanceSurcharge": {
      "description": "Distance > 10km",
      "formula": "basePrice + (distance - 10) * 5",
      "applies": ["moving", "recycling"]
    },
    "sizePremium": {
      "small": 0.9,
      "medium": 1.0,
      "large": 1.3,
      "applies": ["cleaning", "moving", "garden"]
    }
  },
  "safetyRules": {
    "blockedTasks": [
      {
        "keywords": ["gas line", "gas installation"],
        "reason": "Requires certified gas technician",
        "alternative": "Contact licensed gas company"
      },
      {
        "keywords": ["structural", "load-bearing wall", "foundation"],
        "reason": "Requires licensed contractor",
        "alternative": "Contact construction company"
      },
      {
        "keywords": ["asbestos", "lead paint", "toxic"],
        "reason": "Requires hazmat certification",
        "alternative": "Contact environmental specialist"
      },
      {
        "keywords": ["high voltage", "electrical panel", "main breaker"],
        "reason": "Requires master electrician",
        "alternative": "Contact licensed electrician"
      },
      {
        "keywords": ["sewer line", "main water line"],
        "reason": "Requires licensed plumber",
        "alternative": "Contact plumbing company"
      }
    ],
    "verificationGates": {
      "L0": {
        "maxJobValue": 0,
        "allowedServices": [],
        "description": "Email only - Browse only"
      },
      "L1": {
        "maxJobValue": 50,
        "allowedServices": ["cleaning", "moving", "recycling", "handyman", "garden"],
        "description": "KYC verified - Simple jobs"
      },
      "L2": {
        "maxJobValue": 500,
        "allowedServices": ["cleaning", "moving", "recycling", "handyman", "technical", "garden"],
        "description": "License verified - Standard jobs"
      },
      "L3": {
        "maxJobValue": 999999,
        "allowedServices": ["cleaning", "moving", "recycling", "handyman", "technical", "garden"],
        "b2bAccess": true,
        "description": "Background check - Premium jobs, B2B"
      }
    }
  },
  "matchingRules": {
    "algorithm": "rule_based_scoring",
    "weights": {
      "distance": 30,
      "availability": 25,
      "trustScore": 20,
      "rating": 15,
      "completionRate": 10
    },
    "maxDistance": 20,
    "minRating": 3.5,
    "minCompletionRate": 80
  }
