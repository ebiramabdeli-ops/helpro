{
  "service": "Helpro AI Service",
  "version": "1.0.0",
  "description": "Rule-based Intelligence Engine (NO LLM)",
  "type": "microservice",
  "port": 8000,
  "language": "Python 3.11+",
  "framework": "FastAPI",
  
  "architecture": {
    "layers": [
      "NLP Layer (spaCy)",
      "Intent Classifier (scikit-learn)",
      "Decision Engine (Rule-based)",
      "Scoring System",
      "Optimization Engine",
      "Learning System (Statistics)"
    ]
  },
  
  "capabilities": {
    "nlp": {
      "entity_extraction": true,
      "urgency_detection": true,
      "keyword_extraction": true,
      "service_hints": true
    },
    "intent_classification": {
      "algorithm": "TF-IDF + Logistic Regression",
      "intents": 13,
      "trainable": true,
      "multilingual": true
    },
    "decision_making": {
      "rule_based": true,
      "constraint_checking": true,
      "safety_rules": true,
      "action_suggestions": true
    },
    "scoring": {
      "trust_score": "0-5 scale",
      "quality_score": "0-5 scale",
      "priority_score": "0-100 scale"
    },
    "optimization": {
      "helper_matching": "Weighted scoring",
      "schedule_optimization": "Greedy algorithm",
      "price_suggestions": "Rule-based"
    },
    "learning": {
      "feedback_tracking": true,
      "pattern_detection": true,
      "weight_adjustments": true,
      "statistics": true,
      "llm": false
    }
  },
  
  "languages_supported": [
    "en-GB", "en-IE", "de-DE", "fr-FR", "es-ES", "it-IT",
    "sv-SE", "nb-NO", "da-DK", "fi-FI", "nl-NL", "pt-PT",
    "pl-PL", "ro-RO", "el-GR"
  ],
  
  "performance": {
    "nlp_processing": "~10ms",
    "intent_classification": "~5ms",
    "decision_engine": "~5ms",
    "scoring": "~3ms",
    "matching_100_helpers": "~20ms",
    "total_latency": "~40ms"
  },
  
  "cost": {
    "monthly_1m_requests": "€20-50",
    "vs_llm_gpt4": "$30,000",
    "savings": "600x cheaper"
  },
  
  "dependencies": {
    "fastapi": "0.109.0",
    "uvicorn": "0.27.0",
    "spacy": "3.7.2",
    "scikit-learn": "1.4.0",
    "numpy": "1.26.3",
    "pandas": "2.1.4"
  },
  
  "endpoints": {
    "POST /analyze": "Analyze user text (NLP + Intent)",
    "POST /decide": "Make business decision",
    "POST /score": "Calculate trust/quality/priority",
    "POST /match": "Match helpers to task",
    "POST /feedback": "Record feedback for learning",
    "GET /stats": "Get AI statistics",
    "GET /": "Health check"
  },
  
  "integration": {
    "backend": "NestJS (port 3000)",
    "protocol": "HTTP REST",
    "authentication": "None (internal service)",
    "cors": "http://localhost:3000"
  },
  
  "deployment": {
    "docker": true,
    "cloud": ["AWS", "GCP", "Azure"],
    "scaling": "Horizontal (stateless)",
    "resources": {
      "cpu": "1-2 cores",
      "memory": "1-2 GB",
      "storage": "500 MB"
    }
  },
  
  "philosophy": {
    "motto": "Your AI is a silent operator, not a speaker",
    "principles": [
      "No LLM",
      "No free-text generation",
      "No hallucinations",
      "Predictable rules",
      "Explainable decisions",
      "Low cost",
      "Fast response"
    ]
  },
  
  "roadmap": {
    "phase_1": "✅ Core AI engine (DONE)",
    "phase_2": "⏳ Train intent classifiers (200-500 examples/lang)",
    "phase_3": "⏳ Connect to real data (users, orders, reviews)",
    "phase_4": "⏳ Deploy to production",
    "phase_5": "⏳ Monitor & improve"
  },
  
  "contact": {
    "repository": "helpro",
    "documentation": "AI_SYSTEM_COMPLETE.md",
    "readme": "ai-service/README.md"
  }
}
